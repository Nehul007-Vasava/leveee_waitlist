# Waitlist storage (required on Vercel). Add Upstash Redis from Vercel → Storage / Marketplace
# and these are injected automatically. Leave unset locally to use .data/waitlist.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional links shown on the site
NEXT_PUBLIC_FOUNDER_CALL_URL=
NEXT_PUBLIC_HELPLINE_URL=
