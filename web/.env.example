# Waitlist storage (required in production). From Supabase → Project Settings → API Keys.
# Server-only: never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
# Secret key (sb_secret_...), or set the legacy SUPABASE_SERVICE_ROLE_KEY instead.
SUPABASE_SECRET_KEY=
# Leave both unset locally to store signups in .data/waitlist.json.

# Optional links shown on the site
NEXT_PUBLIC_FOUNDER_CALL_URL=
NEXT_PUBLIC_HELPLINE_URL=
